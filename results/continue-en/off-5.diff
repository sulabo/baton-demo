 """Score rules. See docs/design.md "Score"."""
 
 COIN_POINTS = 10
+COMBO_WINDOW = 3  # ticks, inclusive
+COMBO_CAP = 4
 DISTANCE_POINTS = 1  # per unit of distance
 
 
@@ -8,6 +10,8 @@ class Score:
     def __init__(self):
         self.total = 0
         self.coins = 0
+        self._combo = 0
+        self._last_coin_tick = None
 
     def add_distance(self, distance):
         self.total += distance * DISTANCE_POINTS
@@ -15,10 +19,19 @@ class Score:
     def add_coin(self, tick):
         """Called by game.py with the tick the coin was collected on.
 
-        Combo is not implemented yet: every coin is worth COIN_POINTS.
+        Coins within COMBO_WINDOW ticks of the previous coin build a combo:
+        x1, x2, x3, then x4 (cap). Only coin points are multiplied.
         """
+        last = self._last_coin_tick
+        if last is not None and tick - last <= COMBO_WINDOW:
+            self._combo = min(self._combo + 1, COMBO_CAP)
+        else:
+            self._combo = 1
+        self._last_coin_tick = tick
         self.coins += 1
-        self.total += COIN_POINTS
+        self.total += COIN_POINTS * self._combo
 
     def reset_combo(self):
-        """Called by game.py when a life is lost. Does nothing until combo lands."""
+        """Called by game.py when a life is lost: the next coin is x1."""
+        self._combo = 0
+        self._last_coin_tick = None
