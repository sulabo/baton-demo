+    def test_design_example(self):
+        s = Score()
+        for t in (1, 2, 4, 9):
+            s.add_coin(tick=t)
+        self.assertEqual(s.total, 70)
+        self.assertEqual(s.coins, 4)
+
+    def test_cap_at_x4(self):
+        s = Score()
+        for t in range(1, 6):
+            s.add_coin(tick=t)
+        self.assertEqual(s.total, 10 + 20 + 30 + 40 + 40)
+
+    def test_window_is_inclusive(self):
+        s = Score()
+        s.add_coin(tick=1)
+        s.add_coin(tick=4)  # gap 3 -> continues
+        self.assertEqual(s.total, 30)
+
+    def test_gap_over_3_resets(self):
+        s = Score()
+        s.add_coin(tick=1)
+        s.add_coin(tick=5)  # gap 4 -> new combo
+        self.assertEqual(s.total, 20)
+
+    def test_reset_combo(self):
+        s = Score()
+        s.add_coin(tick=1)
+        s.reset_combo()
+        s.add_coin(tick=2)
+        self.assertEqual(s.total, 20)
+
+    def test_distance_not_multiplied(self):
+        s = Score()
+        s.add_coin(tick=1)
+        s.add_coin(tick=2)
