@@ -15,6 +15,46 @@ class ScoreTest(unittest.TestCase):
         self.assertEqual(s.total, COIN_POINTS)
         self.assertEqual(s.coins, 1)
 
+    def test_design_example(self):
+        s = Score()
+        for t in (1, 2, 4, 9):
+            s.add_coin(t)
+        self.assertEqual(s.total, 70)
+        self.assertEqual(s.coins, 4)
+
+    def test_gap_of_exactly_three_continues(self):
+        s = Score()
+        s.add_coin(1)
+        s.add_coin(4)
+        self.assertEqual(s.total, 30)
+
+    def test_gap_of_four_resets(self):
+        s = Score()
+        s.add_coin(1)
+        s.add_coin(5)
+        self.assertEqual(s.total, 20)
+
+    def test_cap_at_x4(self):
+        s = Score()
+        for t in range(1, 7):
+            s.add_coin(t)
+        self.assertEqual(s.total, 10 + 20 + 30 + 40 + 40 + 40)
+
+    def test_reset_combo(self):
+        s = Score()
+        s.add_coin(1)
+        s.add_coin(2)
+        s.reset_combo()
+        s.add_coin(3)
+        self.assertEqual(s.total, 10 + 20 + 10)
+
+    def test_distance_not_multiplied(self):
+        s = Score()
+        s.add_coin(1)
+        s.add_coin(2)
+        s.add_distance(5)
+        self.assertEqual(s.total, 30 + 5)
+
 
 if __name__ == "__main__":
