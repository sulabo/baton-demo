diff --git a/tests/test_score.py b/tests/test_score.py
index 5603857..bbf65c3 100644
--- a/tests/test_score.py
+++ b/tests/test_score.py
@@ -15,6 +15,41 @@ class ScoreTest(unittest.TestCase):
         self.assertEqual(s.total, COIN_POINTS)
         self.assertEqual(s.coins, 1)
 
+    def test_design_example(self):
+        s = Score()
+        for t in (1, 2, 4, 9):
+            s.add_coin(tick=t)
+        self.assertEqual(s.total, 70)
+
+    def test_cap_at_x4(self):
+        s = Score()
+        for t in (1, 2, 3, 4, 5):
+            s.add_coin(tick=t)
+        self.assertEqual(s.total, 10 + 20 + 30 + 40 + 40)
+
+    def test_gap_boundary_inclusive(self):
+        s = Score()
+        s.add_coin(tick=1)
+        s.add_coin(tick=4)  # gap 3 continues
+        self.assertEqual(s.total, 30)
+        s.add_coin(tick=8)  # gap 4 restarts
+        self.assertEqual(s.total, 40)
+
+    def test_reset_combo(self):
+        s = Score()
+        s.add_coin(tick=1)
+        s.add_coin(tick=2)
+        s.reset_combo()
+        s.add_coin(tick=3)
+        self.assertEqual(s.total, 10 + 20 + 10)
+
+    def test_distance_not_multiplied(self):
+        s = Score()
+        s.add_coin(tick=1)
+        s.add_coin(tick=2)
+        s.add_distance(5)
+        self.assertEqual(s.total, 35)
+
 
 if __name__ == "__main__":
     unittest.main()
diff --git a/tinyrunner/score.py b/tinyrunner/score.py
