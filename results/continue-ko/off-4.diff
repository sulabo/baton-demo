@@ -15,6 +15,35 @@ class ScoreTest(unittest.TestCase):
         self.assertEqual(s.total, COIN_POINTS)
         self.assertEqual(s.coins, 1)
 
+    def _coins(self, ticks):
+        s = Score()
+        for t in ticks:
+            s.add_coin(tick=t)
+        return s
+
+    def test_design_example(self):
+        self.assertEqual(self._coins([1, 2, 4, 9]).total, 70)
+
+    def test_multiplier_caps_at_four(self):
+        self.assertEqual(self._coins([1, 2, 3, 4, 5]).total, 10 + 20 + 30 + 40 + 40)
+
+    def test_gap_of_exactly_three_continues(self):
+        self.assertEqual(self._coins([1, 4]).total, 10 + 20)
+
+    def test_gap_of_four_starts_new_combo(self):
+        self.assertEqual(self._coins([1, 5]).total, 10 + 10)
+
+    def test_reset_combo(self):
+        s = self._coins([1, 2])
+        s.reset_combo()
+        s.add_coin(tick=3)
+        self.assertEqual(s.total, 10 + 20 + 10)
+
+    def test_distance_not_multiplied(self):
+        s = self._coins([1, 2, 3])
+        s.add_distance(5)
+        self.assertEqual(s.total, 10 + 20 + 30 + 5)
+
 
 if __name__ == "__main__":
