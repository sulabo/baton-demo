--- a/tinyrunner/score.py
+++ b/tinyrunner/score.py
@@ -2,12 +2,16 @@
 
 COIN_POINTS = 10
 DISTANCE_POINTS = 1  # per unit of distance
+COMBO_WINDOW = 3
+COMBO_CAP = 4
 
 
 class Score:
     def __init__(self):
         self.total = 0
         self.coins = 0
+        self._combo = 0
+        self._last_coin_tick = None
 
     def add_distance(self, distance):
         self.total += distance * DISTANCE_POINTS
@@ -15,10 +19,18 @@ class Score:
     def add_coin(self, tick):
         """Called by game.py with the tick the coin was collected on.
 
-        Combo is not implemented yet: every coin is worth COIN_POINTS.
+        Combo: a coin within COMBO_WINDOW ticks of the previous one continues
+        the combo (x1, x2, x3, then x4 cap). See docs/design.md "Combo".
         """
+        if self._last_coin_tick is not None and tick - self._last_coin_tick <= COMBO_WINDOW:
+            self._combo += 1
+        else:
+            self._combo = 1
+        self._last_coin_tick = tick
         self.coins += 1
-        self.total += COIN_POINTS
+        self.total += COIN_POINTS * min(self._combo, COMBO_CAP)
 
     def reset_combo(self):
-        """Called by game.py when a life is lost. Does nothing until combo lands."""
+        """Called by game.py when a life is lost."""
+        self._combo = 0
+        self._last_coin_tick = None
