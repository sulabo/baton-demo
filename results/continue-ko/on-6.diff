diff --git a/tests/test_score.py b/tests/test_score.py
index 5603857..9eb5fd6 100644
--- a/tests/test_score.py
+++ b/tests/test_score.py
@@ -15,6 +15,44 @@ class ScoreTest(unittest.TestCase):
         self.assertEqual(s.total, COIN_POINTS)
         self.assertEqual(s.coins, 1)
 
+    def test_combo_example_from_design(self):
+        s = Score()
+        for t in (1, 2, 4, 9):
+            s.add_coin(tick=t)
+        self.assertEqual(s.total, 70)
+
+    def test_window_is_inclusive(self):
+        s = Score()
+        s.add_coin(tick=1)
+        s.add_coin(tick=4)
+        self.assertEqual(s.total, 30)
+
+    def test_gap_resets_combo(self):
+        s = Score()
+        s.add_coin(tick=1)
+        s.add_coin(tick=5)
+        self.assertEqual(s.total, 20)
+
+    def test_multiplier_caps_at_four(self):
+        s = Score()
+        for t in range(1, 7):
+            s.add_coin(tick=t)
+        self.assertEqual(s.total, 10 + 20 + 30 + 40 + 40 + 40)
+
+    def test_reset_combo(self):
+        s = Score()
+        s.add_coin(tick=1)
+        s.reset_combo()
+        s.add_coin(tick=2)
+        self.assertEqual(s.total, 20)
+
+    def test_distance_not_multiplied(self):
+        s = Score()
+        s.add_coin(tick=1)
+        s.add_coin(tick=2)
+        s.add_distance(5)
+        self.assertEqual(s.total, 35)
+
 
 if __name__ == "__main__":
     unittest.main()
diff --git a/tinyrunner/score.py b/tinyrunner/score.py
index 112c13d..69ae3e6 100644
--- a/tinyrunner/score.py
+++ b/tinyrunner/score.py
@@ -4,10 +4,16 @@ COIN_POINTS = 10
 DISTANCE_POINTS = 1  # per unit of distance
 
 
+COMBO_WINDOW = 3
+COMBO_CAP = 4
+
+
 class Score:
     def __init__(self):
         self.total = 0
         self.coins = 0
+        self._combo = 0
+        self._last_coin_tick = None
 
     def add_distance(self, distance):
         self.total += distance * DISTANCE_POINTS
@@ -15,10 +21,19 @@ class Score:
     def add_coin(self, tick):
         """Called by game.py with the tick the coin was collected on.
 
-        Combo is not implemented yet: every coin is worth COIN_POINTS.
+        Coins within COMBO_WINDOW ticks of the previous one continue the combo
+        (x1, x2, x3, then x4 cap). See docs/design.md "Combo".
         """
+        if (self._last_coin_tick is not None
+                and tick - self._last_coin_tick <= COMBO_WINDOW):
+            self._combo += 1
+        else:
+            self._combo = 1
+        self._last_coin_tick = tick
         self.coins += 1
-        self.total += COIN_POINTS
+        self.total += COIN_POINTS * min(self._combo, COMBO_CAP)
 
     def reset_combo(self):
-        """Called by game.py when a life is lost. Does nothing until combo lands."""
+        """Called by game.py when a life is lost."""
+        self._combo = 0
+        self._last_coin_tick = None
