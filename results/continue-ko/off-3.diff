diff --git a/tests/test_score.py b/tests/test_score.py
index 5603857..7e4a597 100644
--- a/tests/test_score.py
+++ b/tests/test_score.py
@@ -15,6 +15,37 @@ class ScoreTest(unittest.TestCase):
         self.assertEqual(s.total, COIN_POINTS)
         self.assertEqual(s.coins, 1)
 
+    def _coins(self, *ticks):
+        s = Score()
+        for t in ticks:
+            s.add_coin(tick=t)
+        return s
+
+    def test_design_example(self):
+        s = self._coins(1, 2, 4, 9)
+        self.assertEqual(s.total, 70)
+        self.assertEqual(s.coins, 4)
+
+    def test_window_is_inclusive(self):
+        self.assertEqual(self._coins(1, 4).total, 30)
+
+    def test_gap_over_window_restarts(self):
+        self.assertEqual(self._coins(1, 5).total, 20)
+
+    def test_multiplier_caps_at_four(self):
+        self.assertEqual(self._coins(1, 2, 3, 4, 5).total, 10 + 20 + 30 + 40 + 40)
+
+    def test_reset_combo(self):
+        s = self._coins(1, 2)
+        s.reset_combo()
+        s.add_coin(tick=3)
+        self.assertEqual(s.total, 10 + 20 + 10)
+
+    def test_distance_not_multiplied(self):
+        s = self._coins(1, 2)
+        s.add_distance(5)
+        self.assertEqual(s.total, 10 + 20 + 5)
+
 
 if __name__ == "__main__":
     unittest.main()
diff --git a/tinyrunner/score.py b/tinyrunner/score.py
