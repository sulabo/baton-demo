diff --git a/tests/test_score.py b/tests/test_score.py
index 5603857..b6b688a 100644
--- a/tests/test_score.py
+++ b/tests/test_score.py
@@ -15,6 +15,33 @@ class ScoreTest(unittest.TestCase):
         self.assertEqual(s.total, COIN_POINTS)
         self.assertEqual(s.coins, 1)
 
+    def _coins(self, ticks):
+        s = Score()
+        for t in ticks:
+            s.add_coin(tick=t)
+        return s
+
+    def test_combo_example(self):
+        self.assertEqual(self._coins([1, 2, 4, 9]).total, 70)
+
+    def test_combo_cap(self):
+        self.assertEqual(self._coins([1, 2, 3, 4, 5]).total, 10 + 20 + 30 + 40 + 40)
+
+    def test_window_inclusive(self):
+        self.assertEqual(self._coins([1, 4]).total, 30)
+        self.assertEqual(self._coins([1, 5]).total, 20)
+
+    def test_reset_combo(self):
+        s = self._coins([1, 2])
+        s.reset_combo()
+        s.add_coin(tick=3)
+        self.assertEqual(s.total, 10 + 20 + 10)
+
+    def test_distance_not_multiplied(self):
+        s = self._coins([1, 2])
+        s.add_distance(5)
+        self.assertEqual(s.total, 30 + 5)
+
 
 if __name__ == "__main__":
     unittest.main()
diff --git a/tinyrunner/score.py b/tinyrunner/score.py
index 112c13d..b0fd2d8 100644
--- a/tinyrunner/score.py
+++ b/tinyrunner/score.py
@@ -1,6 +1,8 @@
 """Score rules. See docs/design.md "Score"."""
 
 COIN_POINTS = 10
+COMBO_WINDOW = 3  # ticks, inclusive
+COMBO_CAP = 4
 DISTANCE_POINTS = 1  # per unit of distance
 
 
@@ -8,6 +10,8 @@ class Score:
     def __init__(self):
         self.total = 0
         self.coins = 0
+        self._last_coin_tick = None
+        self._combo = 0
 
     def add_distance(self, distance):
         self.total += distance * DISTANCE_POINTS
@@ -15,10 +19,19 @@ class Score:
     def add_coin(self, tick):
         """Called by game.py with the tick the coin was collected on.
 
-        Combo is not implemented yet: every coin is worth COIN_POINTS.
+        Coins within COMBO_WINDOW ticks of the previous one raise the
+        multiplier (x1, x2, x3, capped at COMBO_CAP).
         """
+        last = self._last_coin_tick
+        if last is not None and tick - last <= COMBO_WINDOW:
+            self._combo += 1
+        else:
+            self._combo = 1
+        self._last_coin_tick = tick
         self.coins += 1
-        self.total += COIN_POINTS
+        self.total += COIN_POINTS * min(self._combo, COMBO_CAP)
 
     def reset_combo(self):
-        """Called by game.py when a life is lost. Does nothing until combo lands."""
+        """Called by game.py when a life is lost. The next coin is x1."""
+        self._last_coin_tick = None
+        self._combo = 0
