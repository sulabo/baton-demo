diff --git a/tests/test_score.py b/tests/test_score.py
index 5603857..f35cc53 100644
--- a/tests/test_score.py
+++ b/tests/test_score.py
@@ -15,6 +15,38 @@ class ScoreTest(unittest.TestCase):
         self.assertEqual(s.total, COIN_POINTS)
         self.assertEqual(s.coins, 1)
 
+    def _coins(self, *ticks):
+        s = Score()
+        for t in ticks:
+            s.add_coin(tick=t)
+        return s
+
+    def test_combo_design_example(self):
+        # docs/design.md "Combo": ticks 1, 2, 4, 9 -> 10 + 20 + 30 + 10
+        s = self._coins(1, 2, 4, 9)
+        self.assertEqual(s.total, 70)
+        self.assertEqual(s.coins, 4)
+
+    def test_combo_window_is_inclusive(self):
+        self.assertEqual(self._coins(1, 4).total, 10 + 20)
+
+    def test_combo_gap_over_window_restarts(self):
+        self.assertEqual(self._coins(1, 5).total, 10 + 10)
+
+    def test_combo_multiplier_caps_at_4(self):
+        self.assertEqual(self._coins(1, 2, 3, 4, 5, 6).total, 10 * (1 + 2 + 3 + 4 + 4 + 4))
+
+    def test_reset_combo_on_life_lost(self):
+        s = self._coins(1, 2)
+        s.reset_combo()
+        s.add_coin(tick=3)
+        self.assertEqual(s.total, 10 + 20 + 10)
+
+    def test_distance_not_multiplied(self):
+        s = self._coins(1, 2)
+        s.add_distance(5)
+        self.assertEqual(s.total, 10 + 20 + 5)
+
 
 if __name__ == "__main__":
     unittest.main()
