diff --git a/tests/test_score.py b/tests/test_score.py
index 5603857..9e8d04d 100644
--- a/tests/test_score.py
+++ b/tests/test_score.py
@@ -15,6 +15,47 @@ class ScoreTest(unittest.TestCase):
         self.assertEqual(s.total, COIN_POINTS)
         self.assertEqual(s.coins, 1)
 
+    def test_combo_design_example(self):
+        # docs/design.md "Combo": ticks 1, 2, 4, 9 -> 10 + 20 + 30 + 10
+        s = Score()
+        for tick in (1, 2, 4, 9):
+            s.add_coin(tick)
+        self.assertEqual(s.total, 70)
+        self.assertEqual(s.coins, 4)
+
+    def test_combo_window_is_inclusive(self):
+        s = Score()
+        s.add_coin(1)
+        s.add_coin(4)  # gap of exactly 3 continues the combo
+        self.assertEqual(s.total, 10 + 20)
+
+    def test_combo_gap_over_window_restarts(self):
+        s = Score()
+        s.add_coin(1)
+        s.add_coin(5)  # gap of 4 starts a new combo
+        self.assertEqual(s.total, 10 + 10)
+
+    def test_combo_caps_at_four(self):
+        s = Score()
+        for tick in range(1, 7):
+            s.add_coin(tick)
+        self.assertEqual(s.total, 10 + 20 + 30 + 40 + 40 + 40)
+
+    def test_reset_combo(self):
+        s = Score()
+        s.add_coin(1)
+        s.add_coin(2)
+        s.reset_combo()
+        s.add_coin(3)  # within window, but a life was lost
+        self.assertEqual(s.total, 10 + 20 + 10)
+
+    def test_distance_not_multiplied(self):
+        s = Score()
+        s.add_coin(1)
+        s.add_coin(2)
+        s.add_distance(5)
+        self.assertEqual(s.total, 10 + 20 + 5)
+
 
 if __name__ == "__main__":
     unittest.main()
