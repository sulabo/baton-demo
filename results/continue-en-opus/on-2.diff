 Newest first.
 
+## 0.4.0 (2026-11-23)
+- Coin combo: coins within 3 ticks of the previous one score ×2, ×3, then ×4 (cap).
+  Losing a life resets the combo. Distance points are not multiplied.
+
 ## 0.3.0 (2026-11-16)
 - Obstacle spawn tables per level (`tinyrunner/obstacles.py`).
 
diff --git a/tests/test_score.py b/tests/test_score.py
index 5603857..ce027eb 100644
--- a/tests/test_score.py
+++ b/tests/test_score.py
@@ -15,6 +15,41 @@ class ScoreTest(unittest.TestCase):
         self.assertEqual(s.total, COIN_POINTS)
         self.assertEqual(s.coins, 1)
 
+    def _coins(self, ticks, score=None):
+        s = score or Score()
+        for t in ticks:
+            s.add_coin(tick=t)
+        return s
+
+    def test_combo_design_example(self):
+        # docs/design.md "Combo": ticks 1, 2, 4, 9 -> 10 + 20 + 30 + 10
+        s = self._coins([1, 2, 4, 9])
+        self.assertEqual(s.total, 70)
+        self.assertEqual(s.coins, 4)
+
+    def test_combo_window_is_inclusive(self):
+        s = self._coins([1, 4])  # gap of exactly 3 continues
+        self.assertEqual(s.total, 10 + 20)
+
+    def test_combo_gap_over_window_restarts(self):
+        s = self._coins([1, 5])  # gap of 4 starts a new combo
+        self.assertEqual(s.total, 10 + 10)
+
+    def test_combo_caps_at_x4(self):
+        s = self._coins([1, 2, 3, 4, 5])
+        self.assertEqual(s.total, 10 + 20 + 30 + 40 + 40)
+
+    def test_reset_combo(self):
+        s = self._coins([1, 2])
+        s.reset_combo()
+        s.add_coin(tick=3)
+        self.assertEqual(s.total, 10 + 20 + 10)
+
+    def test_distance_not_multiplied(self):
+        s = self._coins([1, 2, 3])
+        s.add_distance(5)
+        self.assertEqual(s.total, 10 + 20 + 30 + 5)
+
 
 if __name__ == "__main__":
     unittest.main()
