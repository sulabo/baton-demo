 COIN_POINTS = 10
 DISTANCE_POINTS = 1  # per unit of distance
+COMBO_WINDOW = 3  # ticks; a coin within this many ticks continues the combo
+COMBO_CAP = 4  # highest multiplier
 
 
 class Score:
     def __init__(self):
         self.total = 0
         self.coins = 0
+        self.combo = 0  # position in the current combo; 0 = no combo
+        self.last_coin_tick = None
 
     def add_distance(self, distance):
         self.total += distance * DISTANCE_POINTS
@@ -15,10 +19,21 @@ class Score:
     def add_coin(self, tick):
         """Called by game.py with the tick the coin was collected on.
 
-        Combo is not implemented yet: every coin is worth COIN_POINTS.
+        Applies the combo multiplier (docs/design.md "Combo").
         """
+        if (
+            self.combo
+            and self.last_coin_tick is not None
+            and tick - self.last_coin_tick <= COMBO_WINDOW
+        ):
+            self.combo += 1
+        else:
+            self.combo = 1
+        self.last_coin_tick = tick
         self.coins += 1
-        self.total += COIN_POINTS
+        self.total += COIN_POINTS * min(self.combo, COMBO_CAP)
 
     def reset_combo(self):
-        """Called by game.py when a life is lost. Does nothing until combo lands."""
+        """Called by game.py when a life is lost. The next coin is x1."""
+        self.combo = 0
+        self.last_coin_tick = None
