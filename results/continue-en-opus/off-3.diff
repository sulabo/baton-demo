diff --git a/tests/test_score.py b/tests/test_score.py
index 5603857..6d6ebe5 100644
--- a/tests/test_score.py
+++ b/tests/test_score.py
@@ -15,6 +15,37 @@ class ScoreTest(unittest.TestCase):
         self.assertEqual(s.total, COIN_POINTS)
         self.assertEqual(s.coins, 1)
 
+    def _coin_points(self, ticks, reset_after=()):
+        s = Score()
+        for t in ticks:
+            s.add_coin(tick=t)
+            if t in reset_after:
+                s.reset_combo()
+        return s.total
+
+    def test_combo_design_example(self):
+        # docs/design.md "Combo": ticks 1, 2, 4, 9 -> 10 + 20 + 30 + 10
+        self.assertEqual(self._coin_points([1, 2, 4, 9]), 70)
+
+    def test_combo_window_is_inclusive(self):
+        # gap of exactly 3 continues the combo, gap of 4 does not
+        self.assertEqual(self._coin_points([1, 4]), 10 + 20)
+        self.assertEqual(self._coin_points([1, 5]), 10 + 10)
+
+    def test_combo_caps_at_x4(self):
+        self.assertEqual(self._coin_points([1, 2, 3, 4, 5]), 10 + 20 + 30 + 40 + 40)
+
+    def test_reset_combo(self):
+        self.assertEqual(self._coin_points([1, 2, 3], reset_after=(2,)), 10 + 20 + 10)
+
+    def test_distance_not_multiplied(self):
+        s = Score()
+        s.add_coin(tick=1)
+        s.add_coin(tick=2)
+        s.add_distance(5)
+        self.assertEqual(s.total, 10 + 20 + 5)
+        self.assertEqual(s.coins, 2)
+
 
 if __name__ == "__main__":
     unittest.main()
